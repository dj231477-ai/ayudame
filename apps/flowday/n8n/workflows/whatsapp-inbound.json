{
  "name": "whatsapp-inbound",
  "_comment": "SPEC §C-12.2 / §C-13.10: recibe mensajes de WhatsApp (Meta valida su propia firma X-Hub-Signature-256 dentro del nodo WhatsApp Trigger), reenvía el payload crudo a la app firmado con el mismo HMAC que el resto de eventos de n8n (INV-5). n8n no decide negocio (AR-3) — solo reenvía.",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [260, 300],
      "webhookId": "whatsapp-inbound",
      "credentials": {
        "whatsAppTriggerApi": { "id": "whatsapp-trigger-credential", "name": "FlowDay WhatsApp" }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = JSON.stringify($input.item.json.body ?? $input.item.json);\nconst signature = crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(body, 'utf8').digest('hex');\nreturn { json: { body, signature } };"
      },
      "id": "sign-hmac",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_URL}}/api/v1/webhooks/whatsapp-inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-flowday-signature", "value": "={{$json.signature}}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {}
      },
      "id": "forward-to-app",
      "name": "POST /api/v1/webhooks/whatsapp-inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300]
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "Firmar HMAC", "type": "main", "index": 0 }]] },
    "Firmar HMAC": { "main": [[{ "node": "POST /api/v1/webhooks/whatsapp-inbound", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
