{
  "name": "whatsapp-inbound",
  "_comment": "SPEC §C-12.2 / §C-13.10: recibe mensajes de WhatsApp (Meta valida su propia firma X-Hub-Signature-256 dentro del nodo WhatsApp Trigger), reenvía el payload crudo a la app autenticado con la misma credencial nativa httpHeaderAuth que el resto de /internal/* (D-6, §C-25) — sin $env, sin HMAC en Code node. n8n no decide negocio (AR-3) — solo reenvía.",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [260, 300],
      "webhookId": "whatsapp-inbound",
      "credentials": {
        "whatsAppTriggerApi": { "id": "whatsapp-trigger-credential", "name": "FlowDay WhatsApp" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ayudame-flowday.vercel.app/internal/whatsapp-inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body ?? $json) }}",
        "options": {}
      },
      "id": "forward-to-app",
      "name": "POST /internal/whatsapp-inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "FLOWDAYADMIN0001", "name": "FlowDay Internal Admin" }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "POST /internal/whatsapp-inbound", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
