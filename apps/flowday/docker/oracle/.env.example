# Variables SOLO de la VM Oracle (no en Vercel). SPEC §C-24.3.
DOMAIN=n8n.flowday.app
POSTGRES_PASSWORD=
N8N_USER=
N8N_PASSWORD=
N8N_WEBHOOK_SECRET=

# No son env vars del contenedor n8n (D-6: los workflows tienen la URL de producción
# hardcodeada y usan la credencial nativa httpHeaderAuth, no $env). INTERNAL_ADMIN_SECRET
# se lee de aquí solo por n8n/setup-credentials.sh al crear esa credencial; debe coincidir
# con el de la app (Vercel).
INTERNAL_ADMIN_SECRET=
