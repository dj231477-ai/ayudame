# n8n local — entorno 'local' (§C-19.1). No usar estos valores en Oracle/producción.
POSTGRES_PASSWORD=
N8N_USER=
N8N_PASSWORD=
N8N_WEBHOOK_SECRET=

# No son env vars del contenedor n8n (D-6: los workflows usan una credencial nativa, no
# $env). INTERNAL_ADMIN_SECRET se lee de aquí solo por n8n/setup-credentials.sh al crear
# esa credencial (N8N_ENV_FILE=./docker/local/.env ./n8n/setup-credentials.sh).
INTERNAL_ADMIN_SECRET=
